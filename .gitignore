.gitignore

# Local dependencies and build outputs
node_modules/
dist/
target/
build/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Desktop packaging outputs (real CI artifacts, not source)
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/.gitkeep
desktop/src-tauri/gen/
desktop/src-tauri/generated-help/
release-assets/

# Agent, acceptance, deployment, and nested-worktree state
.tools/
.agents/
.codex/
.deploy-worktree/
.guardrails-worktree/
.milestone-*-commit/
.release-*-worktree/
.stagepilot-backup/
graphify-out/
*.sqlite
*.sqlite3
*.db
journal-*.json
*.local.json
*.local.toml
*.local.yaml
*.local.yml

# Logs
*.log
*.pid
logs/
.logs/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# Credentials and signing material
.env
.env.*
!.env.example
!*.env.example
*.key
*.pem
private_key.*
public_key.*
*.p12
*.pfx
*.mobileprovision

# Project-specific tooling/scratch (kept for privacy — do not remove)
create-new-release.ps1
tools/multitracks-cues/reports/
tools/multitracks-cues/dist-sidecar/
.tools/codex-schema.*/
**/agent-transcripts/
**/agent-auth/
